# Copy this file to ".env" and choose your own demo administrator login.
IOTSHIELD_ADMIN_USER=admin
IOTSHIELD_ADMIN_PASSWORD=change-me-before-the-demo

# Two-factor authentication: after the password, a 6-digit code is emailed to
# IOTSHIELD_ADMIN_EMAIL via Gmail. To send real emails you need a Gmail account with
# 2-Step Verification turned on, then an "App Password" for it (not your normal Gmail
# password): Google Account -> Security -> 2-Step Verification -> App passwords ->
# create one for "Mail" and paste the 16-character result below.
# IOTSHIELD_ADMIN_EMAIL=you@gmail.com             # where the code is sent (the "given gmail")
# IOTSHIELD_SMTP_EMAIL=you@gmail.com              # Gmail account that sends it (can be the same one)
# IOTSHIELD_SMTP_PASSWORD=<16-character App Password>
#
# Leave the three lines above out and IoTShield still works for the demo: since no email can
# be sent, the code is shown directly on the login page instead (with a note explaining why).
# IOTSHIELD_EMAIL_OTP_ENABLED=false               # set to disable 2FA entirely (password only)
# IOTSHIELD_EMAIL_OTP_SHOW_FALLBACK=false         # stop showing the code even if the email fails

# Optional (created automatically on first run if you leave them out):
# IOTSHIELD_SECRET_KEY=any-long-random-string     # signs the login cookie
# IOTSHIELD_MASTER_KEY=<Fernet key>               # encrypts device keys in the database
# PORT=5001
